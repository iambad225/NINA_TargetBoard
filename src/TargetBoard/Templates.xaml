<ResourceDictionary
    x:Class="TargetBoard.Templates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:board="clr-namespace:TargetBoard.Board"
    xmlns:settings="clr-namespace:TargetBoard.Settings"
    xmlns:util="clr-namespace:TargetBoard.Util">

    <util:BoolToVisibility x:Key="TargetBoard_BoolToVis" />

    <!--  The dock panel. NINA finds it by the panel class's full name plus "_Dockable".  -->
    <DataTemplate x:Key="TargetBoard.Board.TargetBoardDockable_Dockable">
        <Grid>
            <Grid Visibility="{Binding SettingsVisible, Converter={StaticResource TargetBoard_BoolToVis}}">
                <settings:SettingsView DataContext="{Binding Board.Settings}" />
            </Grid>
            <Grid Visibility="{Binding SettingsVisible, Converter={StaticResource TargetBoard_BoolToVis}, ConverterParameter=invert}">
                <board:BoardView DataContext="{Binding Board}" />
            </Grid>
        </Grid>
    </DataTemplate>

    <!--  The page under Options > Plugins. NINA finds it by the plugin name (AssemblyTitle) plus "_Options".  -->
    <DataTemplate x:Key="Target Board_Options">
        <settings:SettingsView DataContext="{Binding Settings}" />
    </DataTemplate>
</ResourceDictionary>
